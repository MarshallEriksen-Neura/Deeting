{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "deeting",
  "version": "0.1.0-2",
  "identifier": "com.deeting.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev -- --port 3000",
    "beforeBuildCommand": "node ./scripts/build-desktop-web.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Deeting",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#F4F7FB",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": {
      "../../packages/official-skills/": "official-skills/",
      "../../packages/deeting-sdk/": "deeting-sdk/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "./images/",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 400,
          "y": 250
        }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0QjZBRjM1RUQ3RDlERjYKUldUMm5YM3ROYSsyVkVtd0twSUFsWDRiYmpCSElqNXAwZFoybkM1S0RRQ1dJQ1VwbWhXLytnelMK",
      "endpoints": [
        "https://github.com/MarshallEriksen-Neura/Deeting/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["deeting"]
      }
    }
  }
}
