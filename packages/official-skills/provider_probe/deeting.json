{
  "$schema": "../deeting-manifest-schema.json",
  "id": "official.skills.provider_probe",
  "name": "Provider Probe",
  "version": "1.0.0",
  "author": "Deeting Team",
  "description": "Probe AI providers to verify connectivity and schema compatibility.",
  "entry": {
    "backend": "main.py"
  },
  "permissions": [
    "network.outbound"
  ],
  "runtime": ["cloud"],
  "execution": {
    "timeout_seconds": 60
  },
  "capabilities": {
    "llm_tools": "llm-tool.yaml"
  }
}
