{
  "$schema": "../deeting-manifest-schema.json",
  "id": "official.skills.provider_registry",
  "name": "Provider Registry",
  "version": "1.0.0",
  "author": "Deeting Team",
  "description": "Expert plugin for discovering and registering AI Providers.",
  "entry": {
    "backend": "main.py"
  },
  "permissions": [
    "network.outbound"
  ],
  "restricted": true,
  "allowed_roles": ["admin"],
  "runtime": ["local"],
  "execution": {
    "timeout_seconds": 60
  },
  "capabilities": {
    "llm_tools": "llm-tool.yaml"
  }
}
