{
  "$schema": "../deeting-manifest-schema.json",
  "id": "official.skills.image_generation",
  "name": "Image Generation",
  "version": "1.0.0",
  "author": "Deeting Team",
  "description": "Generate images from text descriptions using DALL-E, Midjourney, etc.",
  "entry": {
    "backend": "main.py"
  },
  "permissions": [
    "network.outbound"
  ],
  "runtime": ["cloud", "local"],
  "execution": {
    "timeout_seconds": 120
  },
  "capabilities": {
    "llm_tools": "llm-tool.yaml"
  }
}
