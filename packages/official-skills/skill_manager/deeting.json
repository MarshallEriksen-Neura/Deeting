{
  "$schema": "../deeting-manifest-schema.json",
  "id": "official.skills.skill_manager",
  "name": "Skill Manager",
  "version": "1.0.0",
  "author": "Deeting Team",
  "description": "Autonomous skill installer and local environment manager. Supports git clone and symlinking.",
  "entry": {
    "backend": "main.py"
  },
  "permissions": [
    "fs.write",
    "shell.execute"
  ],
  "runtime": ["local"],
  "execution": {
    "timeout_seconds": 120
  },
  "capabilities": {
    "llm_tools": "llm-tool.yaml"
  }
}
