{
  "$schema": "../deeting-manifest-schema.json",
  "id": "official.skills.code_interpreter",
  "name": "Code Interpreter",
  "version": "1.0.0",
  "author": "Deeting Team",
  "description": "Stateful Python execution for data analysis and math.",
  "entry": {
    "backend": "main.py"
  },
  "permissions": [
    "sandbox.execute"
  ],
  "runtime": ["cloud", "local"],
  "execution": {
    "timeout_seconds": 120
  },
  "capabilities": {
    "llm_tools": "llm-tool.yaml"
  }
}
