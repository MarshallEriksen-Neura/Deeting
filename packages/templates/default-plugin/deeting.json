{
  "id": "com.deeting.template",
  "name": "Deeting Plugin Template",
  "version": "1.0.0",
  "author": "Deeting Team",
  "description": "A starter template for building Deeting plugins with logic and UI.",
  "entry": {
    "backend": "main.py",
    "ui": "ui/index.html"
  },
  "runtime": ["local"],
  "execution": {
    "timeout_seconds": 60
  },
  "permissions": [
    "network.outbound",
    "tools.read"
  ],
  "capabilities": {
    "llm_tools": "llm-tool.yaml"
  }
}
